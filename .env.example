# Copy to .env (never commit real values). See docs/DEPLOY.md for where each comes from.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# AI providers (only Anthropic is required; the others enable the visibility tracker engines)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Enrichment (optional, free)
COMPANIES_HOUSE_API_KEY=

# Shared secret for pg_cron and function-to-function calls: openssl rand -hex 32
CRON_SECRET=

# Optional: the Lovable leads app webhook (include a secret token in the URL)
LEADS_WEBHOOK_URL=

# Admin app (apps/admin/.env.local) uses:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local end-to-end testing only; never set in production:
# DEV_EXTERNAL_API_PROXY=http://host.docker.internal:8787
